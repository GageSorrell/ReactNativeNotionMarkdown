# Copy this file to .env.local and fill in values for your workstation.

# Directory containing your Android Virtual Device definitions, passed to the emulator
# as ANDROID_AVD_HOME. Used by Script/StartEmulator.
ANDROID_AVD_HOME=

# Name of the AVD that Script/StartEmulator should start (as reported by
# `emulator -list-avds`).
DEBUG_AVD=

# Android package name of the debug/test app that Script/StartEmulator should launch,
# e.g. com.authorName.appName.
PKG_NAME=
