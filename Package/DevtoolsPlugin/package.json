{
  "name": "@react-native-notion-markdown/devtools-plugin",
  "version": "0.1.0",
  "type": "module",
  "description": "Expo DevTools plugin for developing react-native-notion-markdown: inspects the Editor transport (snapshots, events, commands) and drives the native editor from a browser panel.",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "build": "expo-module build",
    "build:all": "expo-module prepare && npm run web:export",
    "clean": "expo-module clean",
    "prepare": "expo-module prepare",
    "prepublishOnly": "expo-module prepare && expo-module prepublishOnly && npm run web:export",
    "web:dev": "cd webui && npx expo start -w",
    "web:export": "./scripts/build-webui.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "keywords": [
    "expo",
    "devtools",
    "notion-markdown"
  ],
  "files": [
    "build",
    "dist",
    "expo-module.config.json"
  ],
  "license": "MIT",
  "dependencies": {
    "react-native-notion-markdown": "0.0.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "expo": "57.0.22",
    "expo-module-scripts": "56.0.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "typescript": "~6.0.3"
  },
  "peerDependencies": {
    "expo": ">=57"
  }
}
