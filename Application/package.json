{
  "name": "notion-markdown-storybook",
  "private": true,
  "version": "1.0.0",
  "type": "commonjs",
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "npm run dev",
    "dev": "expo start --dev-client",
    "dev:clean": "expo start --dev-client -c",
    "android": "expo run:android",
    "prebuild:android": "expo prebuild --platform android",
    "storybook:generate": "node ../node_modules/@storybook/react-native/bin/get-stories.js",
    "pretypecheck": "npm run build --workspace react-native-notion-markdown",
    "typecheck": "npm run storybook:generate && tsc --noEmit",
    "lint": "eslint --config eslint.config.mjs ."
  },
  "dependencies": {
    "@gorhom/bottom-sheet": "5.2.14",
    "@gorhom/portal": "1.0.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/slider": "5.2.0",
    "@react-native-notion-markdown/devtools-plugin": "0.1.0",
    "@storybook/addon-ondevice-actions": "10.4.0",
    "@storybook/addon-ondevice-controls": "10.4.0",
    "@storybook/react-native": "10.4.0",
    "@storybook/react-native-theming": "10.4.0",
    "@storybook/react-native-ui": "10.4.0",
    "@storybook/react-native-ui-common": "10.4.0",
    "expo": "57.0.22",
    "expo-asset": "57.0.17",
    "expo-audio": "57.0.5",
    "expo-dev-client": "57.0.18",
    "expo-modules-core": "57.0.18",
    "expo-video": "57.0.4",
    "lucide-react-native": "1.41.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-blob-util": "0.25.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-notion-markdown": "0.0.1",
    "react-native-pdf": "7.0.5",
    "react-native-ratex": "0.3.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "storybook": "10.4.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "typescript": "~6.0.3"
  }
}
