{
  "expo": {
    "name": "Notion Markdown Storybook",
    "slug": "notion-markdown",
    "scheme": "notionmarkdownstorybook",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.gagesorrell.notionmarkdown.storybook",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-dev-client",
      "expo-audio",
      "expo-document-picker",
      "@react-native-community/datetimepicker",
      "expo-status-bar",
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "3bcef71e-7454-433c-8e10-92bcfc6aa89c"
      }
    },
    "owner": "gagesorrell"
  }
}
