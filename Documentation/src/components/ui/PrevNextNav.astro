---
/** @module @react-native-notion-markdown/documentation/components/ui/PrevNextNav @file PrevNextNav.astro @author Gage Sorrell <gage@sorrell.sh> @copyright (c) 2026 Gage Sorrell @license MIT */
import { ChevronLeft, ChevronRight } from "@lucide/astro"
export type PrevNextLink = { readonly href: string; readonly label: string }
interface Props { readonly prev?: PrevNextLink | null; readonly next?: PrevNextLink | null; readonly label?: string }
const { prev = null, next = null, label = "Document navigation" } = Astro.props
---
{(prev || next) && <nav aria-label={label} class="mt-16 grid grid-cols-1 gap-4 border-t border-border pt-10 sm:grid-cols-2">{prev ? <a href={prev.href} class="group rounded-md border border-border p-4 hover:border-border-strong"><span class="flex items-center gap-1.5 font-mono text-xs uppercase text-muted-foreground"><ChevronLeft class="size-3.5" />Previous</span><span class="mt-1 block text-sm font-medium text-muted-foreground group-hover:text-foreground">{prev.label}</span></a> : <div />}{next ? <a href={next.href} class="group rounded-md border border-border p-4 text-right hover:border-border-strong"><span class="flex items-center justify-end gap-1.5 font-mono text-xs uppercase text-muted-foreground">Next<ChevronRight class="size-3.5" /></span><span class="mt-1 block text-sm font-medium text-muted-foreground group-hover:text-foreground">{next.label}</span></a> : <div />}</nav>}
