---
/** @module @react-native-notion-markdown/documentation/components/ui/VersionSwitch @file VersionSwitch.astro @author Gage Sorrell <gage@sorrell.sh> @copyright (c) 2026 Gage Sorrell @license MIT */
interface Props { readonly versions: ReadonlyArray<{ readonly href: string; readonly label: string; readonly active: boolean }>; readonly "aria-label"?: string }
const { versions, "aria-label": ariaLabel = "Documentation version" } = Astro.props
---
<div role="group" aria-label={ariaLabel} class="grid gap-1 rounded-lg border border-border p-1" style={`grid-template-columns:repeat(${versions.length},minmax(0,1fr))`}>{versions.map((version) => <a href={version.href} aria-current={version.active ? "page" : undefined} class:list={["rounded-md px-2 py-1 text-center font-mono text-xs", version.active ? "bg-accent font-semibold" : "text-muted-foreground hover:bg-muted"]}>{version.label}</a>)}</div>
