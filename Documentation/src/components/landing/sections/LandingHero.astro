---
import { ArrowRight } from "@lucide/astro"
import LandingInstallCommand from "../LandingInstallCommand.astro"
import LandingGridBackground from "../LandingGridBackground.astro"
import type { LandingPageConfig } from "@/lib/landing"

interface Props {
  readonly config: LandingPageConfig
}

const { config } = Astro.props
---

<section class="effect-landing-hero relative w-full">
  <LandingGridBackground />
  <div aria-hidden="true" class="effect-landing-glow pointer-events-none absolute inset-x-0 top-0 h-150"></div>
  <div class="effect-landing-container relative z-10 mx-auto w-full px-4 pt-20 pb-24">
    <div class="mx-auto max-w-4xl text-center">
      <a href={config.primaryCta.href} class="effect-landing-announce group mb-4 inline-flex items-center gap-2 font-mono text-sm tracking-wider uppercase">
        <span aria-hidden="true">//</span>
        <span>{config.eyebrow}</span>
        <ArrowRight class="transition-transform group-hover:translate-x-0.5" size={16} aria-hidden="true" />
      </a>
      <h1>{config.title}</h1>
      <p class="effect-landing-lead mx-auto mt-6 max-w-3xl">{config.description}</p>
      <div class="mx-auto mt-8 max-w-xl">
        <LandingInstallCommand options={config.installOptions} />
      </div>
      <div class="mt-14 flex flex-col items-center gap-5">
        <p class="effect-landing-label font-mono text-sm font-medium tracking-wider uppercase">{config.content.capabilityLabel}</p>
        <ul class="effect-landing-capability-list flex flex-wrap items-end justify-center gap-x-8 gap-y-5" aria-label="Package capabilities">
          {config.capabilityItems.map((item) => (
            <li><strong>{item.value}</strong><span>{item.label}</span></li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
