---
import { ChevronLeft, ChevronRight } from "@lucide/astro"
import type { LandingPageConfig } from "@/lib/landing"

interface Props { readonly config: LandingPageConfig }
const { config } = Astro.props
---

<section id="quotes" class="effect-landing-section relative z-10 w-full py-24 md:pt-40 md:pb-24">
  <div class="effect-landing-container relative mx-auto w-full px-4">
    <div class="mb-8 flex flex-wrap items-end justify-between gap-6 md:mb-12"><div><p class="effect-landing-label mb-3">{config.content.quotesLabel}</p><h2>{config.content.quotesTitle}</h2></div><div class="flex gap-2"><button type="button" aria-label="Previous statements" class="effect-landing-quote-button"><ChevronLeft class="h-4 w-4" aria-hidden="true" /></button><button type="button" aria-label="Next statements" class="effect-landing-quote-button"><ChevronRight class="h-4 w-4" aria-hidden="true" /></button></div></div>
  </div>
  <div class="effect-landing-quote-rail" tabindex="0" aria-label="Project value statements">
    {config.statements.map((statement) => <article><p>“{statement.title}”</p><div><span>{statement.label}</span><i></i><span>react-native-notion-markdown</span></div></article>)}
  </div>
</section>
