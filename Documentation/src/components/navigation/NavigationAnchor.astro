---
/** @module @react-native-notion-markdown/documentation/components/navigation/NavigationAnchor @file NavigationAnchor.astro @author Gage Sorrell <gage@sorrell.sh> @copyright (c) 2026 Gage Sorrell @license MIT */
import type { NavigationLink } from "@/lib/navigation"
interface Props { readonly link: NavigationLink; readonly class?: string; readonly active?: boolean }
const { link, class: className, active = false } = Astro.props
---
<a href={link.href} class={className} aria-current={active ? "page" : undefined} {...link.kind === "external" ? { target: link.target, rel: link.rel } : {}}>{link.label}</a>
