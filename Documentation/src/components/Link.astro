import type { HTMLAttributes } from "astro/types"
interface Props extends HTMLAttributes<"a"> { readonly href: string }
const { href, ...props } = Astro.props
---
<a href={href} {...href.startsWith("http") ? { target: "_blank", rel: "noopener noreferrer" } : {}} {...props}><slot /></a>
