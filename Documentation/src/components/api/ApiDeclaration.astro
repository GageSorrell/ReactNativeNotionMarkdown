---
import type { ApiDeclaration } from "@/lib/api-reference"
import { declarationKindLabel } from "@/lib/api-reference"
import { renderApiComment } from "@/features/api/render-comment"
interface Props { readonly declaration: ApiDeclaration; readonly repository: string; readonly revision: string; readonly symbolLinks?: Readonly<Record<string, string>> }
const { declaration, repository, revision, symbolLinks = {} } = Astro.props
const sourceUrl = declaration.source?.url ?? `${repository}/blob/${revision}/${declaration.source?.file ?? ""}`
---
<section id={declaration.anchor} class="scroll-mt-24 border-t border-border py-8 first:border-t-0" data-pagefind-body>
  <div class="flex flex-wrap items-center gap-2"><h3 data-pagefind-meta="title" class="m-0 text-xl font-semibold"><a href={`#${declaration.anchor}`} class="no-underline hover:underline">{declaration.name}</a></h3><span class="rounded-full bg-accent px-2 py-0.5 font-mono text-xs text-muted-foreground">{declarationKindLabel(declaration)}</span></div>
    <pre class="mt-4 overflow-x-auto rounded-lg border border-border bg-[var(--code-background)] p-4 font-mono text-sm leading-6 text-[var(--code-foreground)]"><code>{declaration.signature}</code></pre>
  {declaration.description && <div class="prose prose-sm mt-4 max-w-none" set:html={renderApiComment(declaration.description, symbolLinks)} />}
  <div class="mt-4 flex flex-wrap gap-x-5 gap-y-2 text-xs text-muted-foreground">{declaration.since && <span><strong>@since</strong> {declaration.since}</span>}{declaration.source && <a href={sourceUrl} target="_blank" rel="noopener noreferrer" class="underline underline-offset-2">View source{declaration.source.line ? ` · line ${declaration.source.line}` : ""}</a>}</div>
  {declaration.see.length > 0 && <div class="mt-4 text-sm"><strong>See also:</strong> {declaration.see.map((item) => <span class="ml-2 inline-block">{item}</span>)}</div>}
  {declaration.examples.map((example) => <pre class="mt-4 overflow-x-auto rounded-lg border border-border bg-[var(--code-background)] p-4 font-mono text-sm leading-6 text-[var(--code-foreground)]"><code>{example}</code></pre>)}
  {declaration.children.length > 0 && <div class="mt-6 border-l-2 border-border pl-4">{declaration.children.map((child) => <div id={child.anchor} class="scroll-mt-24 py-3"><div class="flex items-center gap-2"><h4 data-pagefind-meta="title" class="m-0 font-semibold"><a href={`#${child.anchor}`} class="no-underline hover:underline">{child.name}</a></h4><span class="font-mono text-xs text-muted-foreground">{declarationKindLabel(child)}</span></div><pre class="mt-2 overflow-x-auto rounded-lg bg-[var(--code-background)] p-3 font-mono text-xs text-[var(--code-foreground)]"><code>{child.signature}</code></pre>{child.description && <div class="prose prose-sm mt-2 max-w-none" set:html={renderApiComment(child.description, symbolLinks)} />}</div>)}</div>}
</section>
